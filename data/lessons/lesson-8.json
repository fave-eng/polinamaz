      "type": "content",
      "variant": "language-note",
      "kicker": "Grammar note",
      "title": "Habit and frequency",
      "rule": "Use the present simple to talk about habits and frequency. Use How often ...? to ask how regularly something happens. Use ever in questions about habits. Use used to + verb for past habits that are not true now.",
      "exampleGroups": [
        {
          "label": "Frequency questions",
          "examples": [
            {
              "text": "How often do you eat out?",
              "emphasis": "How often"
            },
            {
              "text": "Do you ever work weekends?",
              "emphasis": "ever"
            }
          ]
        },
        {
          "label": "Past habits",
          "examples": [
            {
              "text": "I used to have loads of time.",
              "emphasis": "used to have"
            },
            {
              "text": "I worked late one day last week.",
              "emphasis": "one day last week",
              "status": "incorrect",
              "label": "not used to"
            }
          ]
        }
      ]
    },
